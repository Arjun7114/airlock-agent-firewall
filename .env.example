# OpenAI-compatible endpoint the model is served at.
#   Meta Model API : get the exact base URL from https://dev.meta.ai/docs/quickstart
#   Local Ollama   : http://localhost:11434/v1
AIRLOCK_API_BASE=

# API key.
#   Meta Model API : your key from the API keys page in the Meta console
#   Ollama         : any non-empty value works, e.g. ollama
AIRLOCK_API_KEY=

# Model id to call.
#   Meta Model API : a Muse model id from https://dev.meta.ai/docs/models
#   Ollama         : whatever you pulled, e.g. llama3
AIRLOCK_MODEL=